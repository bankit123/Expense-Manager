<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Background color -->
    <solid android:color="@color/main_bg"/>

    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="@color/nav_icon_default" />

    <!-- Rounded corners -->
    <corners android:radius="8dp"/>

    <!-- Padding inside -->
    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="8dp"
        android:bottom="8dp"/>
</shape>
