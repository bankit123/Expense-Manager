<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- 🎨 Subtle gradient for dark mode -->
    <gradient
        android:startColor="@color/spend_red_light_translucent"
        android:centerColor="@color/spend_red_light_translucent"
        android:endColor="@color/spend_red_light"
        android:angle="270" />

    <!-- 🩶 Softer border (less brightness) -->
    <stroke
        android:width="1dp"
        android:color="@color/spend_red_light_translucent" />

    <!-- 🔥 Base fill -->
    <solid android:color="@color/spend_red_light_translucent" />
</shape>
