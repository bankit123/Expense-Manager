<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/same_color"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close_btn"
            app:tint="@color/ic_color"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Add Category"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/ic_color"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Add Button -->
        <LinearLayout
            android:id="@+id/btnAddCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_categories_add"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp">


    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row: Icon + Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <!-- Icon Preview -->
                <FrameLayout
                    android:id="@+id/iconContainer"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_rounded_user_profile"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivCategoryIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_category"
                        android:visibility="visible"
                        app:tint="@color/opposite_color" />

<!--                    <TextView-->
<!--                        android:id="@+id/tvCategoryLetter"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_gravity="center"-->
<!--                        android:text="?"-->
<!--                        android:textColor="@android:color/white"-->
<!--                        android:textSize="22sp"-->
<!--                        android:textStyle="bold" />-->
                </FrameLayout>

                <!-- Category Name -->
                <EditText
                    android:id="@+id/etNewCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Category Name"
                    android:background="@drawable/bg_input"
                    android:inputType="textCapWords"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Section: Color Picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvChooseColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Color"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvColors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never" />
            </LinearLayout>

            <!-- Section: Icon Picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvChooseIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Icon"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvIcons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
