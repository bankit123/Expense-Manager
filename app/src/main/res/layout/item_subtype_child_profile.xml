<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp">

    <!-- Delete Background -->
    <LinearLayout
        android:id="@+id/btnDeleteBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_swipe_delete_rounded"
        android:gravity="center_vertical|end"
        android:paddingEnd="25dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_effect"
            android:gravity="center">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/red"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- Foreground -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="10dp">

        <FrameLayout
            android:id="@+id/bgSubtypeIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:layout_marginEnd="10dp">
            <ImageView
                android:id="@+id/ivSubtypeIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tvSubtypeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subtype Name"
            android:textSize="13sp"
            android:textColor="@color/opposite_color"/>
    </LinearLayout>
</FrameLayout>
