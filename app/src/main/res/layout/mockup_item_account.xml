<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="16dp">

    <!-- 🟥 Background: Delete Button -->
    <LinearLayout
        android:id="@+id/btnDeleteBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_swipe_delete_rounded"
        android:gravity="center_vertical|end"
        android:paddingEnd="25dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_effect"
            android:gravity="center">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/red"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- 🟢 Foreground: Account Item -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible"
        android:background="@drawable/bg_border">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivAccountIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvAccountName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:textColor="@color/opposite_color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="Account Name" />

            <TextView
                android:id="@+id/tvAccountAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/opposite_color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="₹700" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_account_details"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTransactionDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Transaction Details"
                android:textColor="@color/opposite_color"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingVertical="10dp"
                android:paddingHorizontal="16dp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_forward"
                android:layout_marginEnd="16dp"
                android:tint="@color/ic_color" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
