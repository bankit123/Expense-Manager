<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_toggle_unselected_filter"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="11dp">

    <!-- Icon Container -->


    <ImageView
        android:id="@+id/ivSubtypeIcon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="center"
        android:tint="@color/opposite_color" />


    <!-- Label -->
    <TextView
        android:id="@+id/tvSubtypeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:layout_marginStart="5dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:text="Subtype"
        android:textColor="@color/opposite_color"
        android:textSize="12sp" />
</LinearLayout>
