<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nav_bg"
    android:fitsSystemWindows="true">

    <!-- Content container -->
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="70dp" />


    <!-- Custom Bottom Navbar -->
    <LinearLayout
        android:id="@+id/custom_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_home"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_menu_home" />

            <TextView
                android:id="@+id/title_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:layout_marginTop="3dp"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Analysis -->
        <LinearLayout
            android:id="@+id/nav_analysis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_analysis"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_menu_analysis" />

            <TextView
                android:id="@+id/title_analysis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analysis"
                android:layout_marginTop="3dp"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Spacer for FAB -->
        <View
            android:layout_width="56dp"
            android:layout_height="match_parent" />

        <!-- Account -->
        <LinearLayout
            android:id="@+id/nav_account"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_account"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_menu_account" />

            <TextView
                android:id="@+id/title_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account"
                android:layout_marginTop="3dp"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Reminder -->
        <LinearLayout
            android:id="@+id/nav_reminder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_reminder"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_menu_reminader" />

            <TextView
                android:id="@+id/title_reminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminder"
                android:layout_marginTop="3dp"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Reminder -->
        <LinearLayout
            android:id="@+id/nav_backup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_backup"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_backup" />

            <TextView
                android:id="@+id/title_backup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Backup"
                android:layout_marginTop="3dp"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Custom Floating Button -->
    <FrameLayout
        android:id="@+id/fab_add_transaction"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|center"
        android:background="@drawable/fab_ripple"
        android:layout_marginBottom="35dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp">

        <ImageView
            android:id="@+id/fab_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_menu_add"
            app:tint="@color/fab_icon" />

    </FrameLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>


