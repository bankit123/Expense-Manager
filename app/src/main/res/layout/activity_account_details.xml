<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    android:fitsSystemWindows="true"
    tools:context="trackmyspend.budgetplanner.expensemanager.Menu_Screen.Account_Screen.Account_Details_Activity">

    <!-- 🔹 All screen content (scrollable) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_alignParentTop="true">

            <!-- 🔹 Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <!-- Back Button -->
                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_back_btn"
                    app:tint="@color/ic_color" />

                <!-- Title -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAccountName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Name"
                        android:textColor="@color/ic_color"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivPaymentMethodBtn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="3dp"
                    android:src="@drawable/ic_payment_method"
                    app:tint="@color/ic_color" />

            </LinearLayout>

            <!-- 🔹 Date Filter Segment -->
            <LinearLayout
                android:id="@+id/filterSegment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_segment_container"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <!--            <TextView-->
                <!--                android:id="@+id/tvAll"-->
                <!--                android:layout_width="0dp"-->
                <!--                android:layout_height="match_parent"-->
                <!--                android:layout_weight="1"-->
                <!--                android:background="@drawable/bg_segment_unselected"-->
                <!--                android:gravity="center"-->
                <!--                android:text="All"-->
                <!--                android:textColor="?attr/colorOnSurfaceVariant"-->
                <!--                android:textSize="12dp"-->
                <!--                android:textStyle="bold" />-->

                <TextView
                    android:id="@+id/tvMonthly"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_unselected"
                    android:gravity="center"
                    android:text="Monthly"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvYearly"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_unselected"
                    android:gravity="center"
                    android:text="Yearly"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPeriod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_unselected"
                    android:gravity="center"
                    android:text="Period"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 🔹 Content Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/main_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Account Balance -->
                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_lay_card_profile"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="6dp"
                    android:text="Balance: ₹0.00"
                    android:textColor="@color/opposite_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/banner_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginTop="16dp"
                    android:visibility="visible" />

                <!-- 🔹 Title + Filter (Inline Row) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTransactionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transaction History"
                            android:textColor="@color/ic_color"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- ✅ Subtitle that Java expects -->
                        <TextView
                            android:id="@+id/tvSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Showing all transactions"
                            android:textColor="@android:color/darker_gray"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- ✅ Filter Button -->
                    <LinearLayout
                        android:id="@+id/filterContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_spinner"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_filter"
                            app:tint="@color/opposite_color" />

                        <TextView
                            android:id="@+id/tvFilterLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Filter"
                            android:textColor="@color/opposite_color"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 🔹 Empty message -->
                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="No transactions found"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- 🔹 RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- 🔹 Empty State View -->
                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_empty_list"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="65dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_emptylist" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No transactions yet"
                        android:textColor="@color/opposite_color"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</RelativeLayout>
