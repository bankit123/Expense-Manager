<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#008CFF"
    tools:context="trackmyspend.budgetplanner.expensemanager.Splash_Screen_Activity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:alpha="0.03"/>

    <!-- Logo or Main Image -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:contentDescription="Logo"
        android:src="@drawable/ic_logo"
        android:layout_centerInParent="true"
        app:tint="@color/same_color" />


    <!-- Subtitle Text at Bottom -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnimationView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/subTxt"
        app:lottie_rawRes="@raw/circle_loader"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <TextView
        android:id="@+id/subTxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/krushi24txt"
        android:gravity="center"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"
        android:textSize="18sp"
        android:textColor="#fff"
        android:text="TrackMySpend" />

    <TextView
        android:id="@+id/krushi24txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="#85FFFFFF"
        android:text="MoneyJar Studio"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp" />



</RelativeLayout>