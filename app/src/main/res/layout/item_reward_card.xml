<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgGift"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_gift"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/tvRewardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reward title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/opposite_color" />

            <TextView
                android:id="@+id/tvRewardPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100 Points"
                android:textSize="12sp"
                android:textColor="@color/opposite_color" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnClaim"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:background="@drawable/bg_btn_save"
            android:text="Claim"
            android:textSize="13sp"
            android:textColor="@color/same_color" />

    </LinearLayout>

    <!-- Divider / HR -->
    <View
        android:id="@+id/viewDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/setting_boarder" />
</LinearLayout>
