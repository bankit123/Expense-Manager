<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@drawable/bg_lay_card_profile"
        android:layout_marginVertical="4dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvScheduleDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nov 15, 2025"
                android:textColor="@color/opposite_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvScheduleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upcoming"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvScheduleAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹500"
                android:layout_marginEnd="5dp"
                android:textColor="@color/opposite_color"
                android:textStyle="bold"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSkipSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:background="@drawable/bg_btn_save"
                    android:layout_marginVertical="5dp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:text="Skip"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:drawablePadding="6dp"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/btnPaySchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:background="@drawable/bg_btn_save"
                    android:layout_marginVertical="5dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center"
                    android:text="Pay"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:drawablePadding="6dp"
                    android:layout_gravity="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ✅ Added Pay Button -->


</LinearLayout>
