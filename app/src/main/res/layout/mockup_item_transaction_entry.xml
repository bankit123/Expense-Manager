<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootTransactionItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 🔴 Background for Swipe Delete -->
    <LinearLayout
        android:id="@+id/btnDeleteBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_swipe_delete_rounded"
        android:gravity="center_vertical|end"
        android:paddingEnd="25dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_effect"
            android:gravity="center">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/red"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- 🧊 Foreground Transaction Card -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:background="@drawable/bg_card_account_details"
        android:orientation="vertical"
        android:descendantFocusability="blocksDescendants"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <!-- Category -->
            <FrameLayout
                android:id="@+id/bgIconCategory"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/ivCategoryIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:tint="@android:color/white" />
            </FrameLayout>

            <!-- Details Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="10dp"
                android:paddingStart="5dp">

                <TextView
                    android:id="@+id/tvCategoryName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Category"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/opposite_color"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tvSourceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Source"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:maxLines="1" />

                <!-- Date -->
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    android:text="Today, 12:30 PM"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Right Side: Amount + Subtype -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="5dp">

                    <FrameLayout
                        android:id="@+id/bgIconAmount"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="5dp"
                        android:layout_gravity="center" />

                    <!-- Amount -->
                    <TextView
                        android:id="@+id/tvAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹500"
                        android:textSize="14sp"
                        android:textColor="@color/opposite_color"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Subtype -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRecurringIcon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="3dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:src="@drawable/ic_repeat"
                        app:tint="@color/opposite_color" />

                    <TextView
                        android:id="@+id/tvSubtypeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="Subtype"
                        android:textSize="10sp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:maxLines="1" />

                    <FrameLayout
                        android:id="@+id/bgIconSubType"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="5dp">

                        <ImageView
                            android:id="@+id/ivSubtypeIcon"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="center"
                            app:tint="@android:color/white" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/hr"
            android:layout_width="match_parent"
            android:layout_height="0.1dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/list_hr" />

        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:textColor="@android:color/darker_gray"
            android:textSize="10sp"
            android:ellipsize="end"
            android:paddingHorizontal="16dp"
            android:paddingVertical="15dp"
            android:maxLines="2" />
    </LinearLayout>
</FrameLayout>
