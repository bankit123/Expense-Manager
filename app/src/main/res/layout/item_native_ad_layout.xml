<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_account_details"
    android:padding="12dp"
    android:orientation="vertical">

    <!-- Top Row: App Icon + Headline -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/ad_icon_desc"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sponsored App"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/opposite_color"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Body Text -->
    <TextView
        android:id="@+id/ad_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Discover amazing financial tools to manage your budget effortlessly."
        android:textSize="13sp"
        android:textColor="@color/gray"
        android:visibility="gone" />

    <!-- Media (Image/Video) -->
    <com.google.android.gms.ads.nativead.MediaView
        android:id="@+id/ad_media"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="10dp"
        android:background="@color/bg_card"
        android:visibility="gone" />

    <!-- CTA + Advertiser -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Advertiser -->
        <TextView
            android:id="@+id/ad_advertiser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sponsored"
            android:textSize="12sp"
            android:textColor="@color/gray"
            android:visibility="gone" />

        <!-- CTA Button -->
        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Install"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/nav_icon_active"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:textAllCaps="false" />
    </LinearLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
