<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!--            Header-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp">

                <!-- Back Button -->
                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_back_btn"
                    app:tint="@color/ic_color"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <!-- Title (Perfect Center Always) -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Transaction"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/opposite_color"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:layout_centerInParent="true" />

                <!-- Remaining Transactions -->
<!--                <TextView-->
<!--                    android:id="@+id/remainingTrans"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="12"-->
<!--                    android:textStyle="bold"-->
<!--                    android:textColor="@color/opposite_color"-->
<!--                    android:background="@drawable/bg_card_account_details"-->
<!--                    android:paddingHorizontal="8dp"-->
<!--                    android:paddingVertical="5dp"-->
<!--                    android:textSize="10sp"-->
<!--                    android:layout_alignParentEnd="true"-->
<!--                    android:layout_centerVertical="true" />-->

            </RelativeLayout>


            <!--            spend income-->
            <LinearLayout
                android:id="@+id/spendIncomeSegment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_segment_container"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- Spend -->
                <TextView
                    android:id="@+id/tvSpend"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_unselected"
                    android:gravity="center"
                    android:text="Spend"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Income -->
                <TextView
                    android:id="@+id/tvIncome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_unselected"
                    android:gravity="center"
                    android:text="Income"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransfer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_unselected"
                    android:gravity="center"
                    android:text="Transfer"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!--            Amount-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_account_details"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="28dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvAmountTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Amount spent"
                    android:textColor="@color/opposite_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Amount Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Rupee Prefix -->
                    <TextView
                        android:id="@+id/currencySymbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="₹"
                        android:textColor="@color/opposite_color"
                        android:textSize="30sp" />

                    <!-- Amount Input -->
                    <EditText
                        android:id="@+id/etAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:hint="Enter amount"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/opposite_color"
                        android:textColorHint="?android:attr/textColorHint"
                        android:textSize="18sp" />

                    <!-- Arrow icon -->
                    <!--                    <ImageView-->
                    <!--                        android:layout_width="20dp"-->
                    <!--                        android:layout_height="20dp"-->
                    <!--                        android:src="@drawable/ic_forward"-->
                    <!--                        android:tint="?android:attr/textColorHint" />-->

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="200dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:alpha="0.4"
                    android:background="?android:attr/textColorHint" />

                <!-- Date & Time Row -->
                <LinearLayout
                    android:id="@+id/date_linearlayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_transcation_card_inside"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Calendar Icon -->
                        <ImageView
                            android:id="@+id/ivCalendar"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Pick date"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/opposite_color" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Date &amp; time"
                            android:textColor="@color/opposite_color"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginStart="5dp"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="dropdown"
                            android:src="@drawable/ic_dropdown"
                            app:tint="@color/opposite_color" />

                    </LinearLayout>

                    <!-- Selected Date & Time -->
                    <TextView
                        android:id="@+id/tvDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Today, 4:37 pm"
                        android:layout_marginTop="8dp"
                        android:textColor="?android:attr/textColorHint"
                        android:textSize="13sp" />

                </LinearLayout>


                <!-- Paid To Row -->
                <LinearLayout
                    android:id="@+id/linear_paidTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_transcation_card_inside"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPayeeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:text="Paid to"
                        android:textColor="@color/opposite_color"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etPayee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:gravity="end"
                        android:hint="Enter the name or place"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords"
                        android:paddingVertical="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/opposite_color"
                        android:textColorHint="?android:attr/textColorHint"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>


            <!--            Category-->
            <LinearLayout
                android:id="@+id/layoutCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_account_details"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="24dp">

                <ImageView
                    android:id="@+id/ivCategoryIconTransaction"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Category"
                    android:src="@drawable/ic_category"
                    app:tint="@color/opposite_color" />

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="Category"
                    android:textColor="@color/opposite_color"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="dropdown"
                    android:src="@drawable/ic_dropdown"
                    app:tint="@color/opposite_color" />

            </LinearLayout>

            <!-- 🔹 ACCOUNT SUBTYPE SELECTOR 1 From-->
            <LinearLayout
                android:id="@+id/layoutSubtype"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_account_details"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="24dp">

                <ImageView
                    android:id="@+id/ivSubtypeIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Subtype"
                    android:src="@drawable/ic_bank"
                    app:tint="@color/opposite_color" />

                <TextView
                    android:id="@+id/tvSubtype"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="Payment Method"
                    android:textColor="@color/opposite_color"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="dropdown"
                    android:src="@drawable/ic_dropdown"
                    app:tint="@color/opposite_color" />

            </LinearLayout>

            <!-- 🔹 ACCOUNT SUBTYPE SELECTOR 2 To-->
            <LinearLayout
                android:id="@+id/layoutSubtypeTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_account_details"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="24dp">

                <ImageView
                    android:id="@+id/ivSubtypeIconTo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Subtype"
                    android:src="@drawable/ic_bank"
                    app:tint="@color/opposite_color" />

                <TextView
                    android:id="@+id/tvSubtypeTo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="Payment Method"
                    android:textColor="@color/opposite_color"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="dropdown"
                    android:src="@drawable/ic_dropdown"
                    app:tint="@color/opposite_color" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/banner_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <!--            Notes-->
            <!-- Notes Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_account_details"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="24dp"
                android:paddingBottom="18dp">

                <!-- Notes Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="Notes"
                        android:src="@drawable/ic_notes"
                        app:tint="@color/opposite_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Notes"
                        android:textColor="@color/opposite_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Notes Input -->
                <EditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent"
                    android:ellipsize="none"
                    android:hint="Tap to add"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="18"
                    android:minLines="2"
                    android:overScrollMode="ifContentScrolls"
                    android:padding="0dp"
                    android:scrollHorizontally="false"
                    android:textColor="@color/opposite_color"
                    android:textColorHint="?android:attr/textColorHint"
                    android:textSize="14sp" />

            </LinearLayout>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <!-- Banner Ad -->
<!--        <FrameLayout-->
<!--            android:id="@+id/banner_container"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_gravity="center_horizontal"-->
<!--            android:paddingTop="4dp"-->
<!--            android:visibility="gone" />-->

        <!-- Save Button -->
        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_btn_save"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_save"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="Save"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
