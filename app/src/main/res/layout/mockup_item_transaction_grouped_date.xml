<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginTop="10dp"
    android:background="@color/co_bg_group_date"
    android:gravity="center_vertical">

    <!-- Date + Day -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/opposite_color" />

        <TextView
            android:id="@+id/tvWeekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:padding="2dp"
            android:text="Fri"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            android:background="@drawable/bg_day_chip" />

        <TextView
            android:id="@+id/tvMonthYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="10.2025"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- Income -->
    <TextView
        android:id="@+id/tvIncomeTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="£0.00"
        android:textSize="13sp"
        android:layout_marginEnd="12dp" />

    <!-- Expense -->
    <TextView
        android:id="@+id/tvExpenseTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="£700.00"
        android:textSize="13sp" />
</LinearLayout>
