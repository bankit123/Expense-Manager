<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCategoryItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 🔴 Background for Delete -->
    <LinearLayout
        android:id="@+id/btnDeleteBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_swipe_delete_rounded"
        android:gravity="center_vertical|end"
        android:paddingEnd="25dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_effect"
            android:gravity="center">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/red"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- 🧊 Foreground Content -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/bgIconCategory"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/ivCategoryIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                app:tint="@color/black" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCategoryName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Category Name"
                android:textColor="@color/opposite_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCategoryType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Category Name"
                android:layout_marginTop="2dp"
                android:textColor="@color/opposite_color"
                android:textSize="10sp" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
