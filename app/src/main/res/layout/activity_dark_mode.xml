<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_bg"
    android:fitsSystemWindows="true"
    tools:context=".Profile.DarkMode_Activity">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
       android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back_btn"
            app:tint="@color/ic_color"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Choose a Mode"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/ic_color"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Main Card -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="4dp"
        android:paddingHorizontal="16dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_lay_card_profile">

        <!-- System Default -->
        <LinearLayout
            android:id="@+id/optionSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Follow System"
                android:textSize="14sp"
                android:textColor="@color/opposite_color" />

            <ImageView
                android:id="@+id/tickSystem"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_system"
                android:visibility="gone"
                app:tint="@color/opposite_color"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/setting_boarder" />

        <!-- Light -->
        <LinearLayout
            android:id="@+id/optionLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Light Mode"
                android:textSize="14sp"
                android:textColor="@color/opposite_color" />

            <ImageView
                android:id="@+id/tickLight"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_lightmode"
                android:visibility="gone"
                app:tint="@color/opposite_color"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/setting_boarder" />

        <!-- Dark -->
        <LinearLayout
            android:id="@+id/optionDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dark Mode"
                android:textSize="14sp"
                android:textColor="@color/opposite_color" />

            <ImageView
                android:id="@+id/tickDark"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_dark_mode"
                android:visibility="gone"
                app:tint="@color/opposite_color" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
