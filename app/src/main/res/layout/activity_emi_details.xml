<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="trackmyspend.budgetplanner.expensemanager.Menu_Screen.Reminder_Screen.EmiDetailsActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLoanName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loan"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lender" />

            <TextView
                android:id="@+id/tvEmiAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMI" />

            <TextView
                android:id="@+id/tvPaid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paid" />

            <TextView
                android:id="@+id/tvTenure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tenure" />

            <TextView
                android:id="@+id/tvStartDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start" />

            <TextView
                android:id="@+id/tvEndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End" />

            <TextView
                android:id="@+id/tvNextDue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next Due" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status" />

            <Button
                android:id="@+id/btnMarkPaid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Mark as Paid" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>